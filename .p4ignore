# Unreal Engine .p4ignore
# 제출 금지 목록: 빌드 산출물 · 중간 파일 · 캐시 · 자동 생성물 · IDE/사용자 설정
# 제출 대상(무시하지 않음): *.uproject, *.uplugin, Source/, Config/, Content/,
#   Plugins/*/Source, Plugins/*/Content, Plugins/*/Shaders, Plugins/*/Resources

# 빌드 산출물 / 중간 파일 / 캐시 — 루트와 모든 Plugins 하위에 동일 적용
Binaries
Build
DerivedDataCache
Intermediate
Saved

# IDE / 에디터 캐시
.vs
.vscode
.idea

# 자동 생성 솔루션·프로젝트 파일 (Generate Project Files 산출물)
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# 사용자별 설정
*.DotSettings.user

# OS 부산물
.DS_Store
Thumbs.db
desktop.ini

# Local Git/Codex workspace metadata
.git
.gitignore
.gitattributes
.claude

# 문서 도구 산출물 (MkDocs)
# site/ 는 `mkdocs build` 가 생성하는 결과물이라 제출 대상이 아님.
# 문서 소스(.md, mkdocs.yml, requirements.txt, assets/)만 제출한다.
/Plugins/SavageSuperStorm/Docs/site

# Python 가상환경 — 워크스페이스 안에 만들었을 때를 대비
.venv
__pycache__
