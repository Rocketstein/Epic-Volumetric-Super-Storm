/**
 * @file StormProfileCS.usf
 * @brief Builds and blends vertical profile render targets.
 */

#pragma once
#include "/Engine/Public/Platform.ush"
#include "/SavageSuperStormShaders/Public/StormProfileField.ush"

uint Resolution;

float BottomFade;

float TopFade;

StructuredBuffer<float> TopHeightLUT;

float                   AnvilFade;
StructuredBuffer<float> AnvilHeightLUT;

RWTexture2D<float4> OutBottomProfileTexture;
RWTexture2D<float4> OutTopProfileTexture;
RWTexture2D<float4> OutAnvilProfileTexture;

float2 BrushCenterUV;
float  BrushRadiusUV;
float  BrushStrength;
float  BrushValue;
uint   bBrushErase;
uint   bBrushOverwrite;

RWTexture2D<float4> PaintedTopTexture;

Texture2D<float4>   ProfileA;
Texture2D<float4>   ProfileB;
float               BlendAlpha;
RWTexture2D<float4> OutBlendedProfileTexture;

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void BuildBottomTypeProfileRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	float2 uv                                    = (DispatchThreadID.xy + 0.5) / Resolution;
	OutBottomProfileTexture[DispatchThreadID.xy] = EvaluateBottomTypeProfile(uv, BottomFade);
}

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void BuildTopTypeProfileRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	float2 uv                                 = (DispatchThreadID.xy + 0.5) / Resolution;
	float  CurveTopHeight                     = TopHeightLUT[DispatchThreadID.x];
	OutTopProfileTexture[DispatchThreadID.xy] = EvaluateTopTypeProfile(uv, TopFade, CurveTopHeight);
}

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void BuildAnvilProfileRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	float2 uv                                   = (DispatchThreadID.xy + 0.5) / Resolution;
	float  CurveDepth                           = AnvilHeightLUT[DispatchThreadID.x];
	OutAnvilProfileTexture[DispatchThreadID.xy] = EvaluateAnvilTypeProfile(uv, AnvilFade, CurveDepth);
}

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void StampProfileBrushRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	if (BrushStrength <= 0.0)
	{
		return;
	}

	float2 uv         = (DispatchThreadID.xy + 0.5) / Resolution;
	float2 BrushDelta = uv - BrushCenterUV;
	float  Distance   = length(BrushDelta);
	float4 Target     = (bBrushErase != 0) ? float4(0.0, 0.0, 0.0, 1.0) : float4(BrushValue, BrushValue, BrushValue, 1.0);

	const float Radius     = max(BrushRadiusUV, 1e-5);
	const bool  bHardErase = bBrushErase != 0 && BrushStrength >= (1.0 - 1e-5);
	const bool  bHardPaint = bBrushErase == 0 && bBrushOverwrite != 0;
	if (bHardErase || bHardPaint)
	{
		if (Distance > Radius)
		{
			return;
		}

		PaintedTopTexture[DispatchThreadID.xy] = Target;
		return;
	}

	float Falloff = 1.0 - smoothstep(0.0, Radius, Distance);
	float Weight  = saturate(Falloff * BrushStrength);
	if (Weight <= 0.0)
	{
		return;
	}

	float4 Current                         = PaintedTopTexture[DispatchThreadID.xy];
	Current.a                              = 1.0;
	PaintedTopTexture[DispatchThreadID.xy] = lerp(Current, Target, Weight);
}

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void BlendProfilesRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	int3   Coord                                  = int3(DispatchThreadID.xy, 0);
	float4 A                                      = ProfileA.Load(Coord);
	float4 B                                      = ProfileB.Load(Coord);
	OutBlendedProfileTexture[DispatchThreadID.xy] = lerp(A, B, saturate(BlendAlpha));
}