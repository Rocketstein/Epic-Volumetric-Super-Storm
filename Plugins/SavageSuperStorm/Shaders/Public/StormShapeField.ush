/**
 * @file StormShapeField.ush
 * @brief Evaluates the radial storm shape written by the compute pass.
 */

#pragma once

float Hash21(float2 p)
{
	p = frac(p * float2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return frac(p.x * p.y);
}

float ValueNoise2D(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);

	float a = Hash21(i + float2(0.0, 0.0));
	float b = Hash21(i + float2(1.0, 0.0));
	float c = Hash21(i + float2(0.0, 1.0));
	float d = Hash21(i + float2(1.0, 1.0));

	float2 u = f * f * (3.0 - 2.0 * f);
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float FBM2D(float2 p)
{
	float v = 0.0;
	float a = 0.5;
	v       += a * ValueNoise2D(p);
	p       *= 2.03;
	a       *= 0.5;
	v       += a * ValueNoise2D(p);
	p       *= 2.07;
	a       *= 0.5;
	v       += a * ValueNoise2D(p);
	return saturate(v);
}

float SampleStormNoise(float2 uv, float scale, float seed)
{
	return FBM2D(uv * scale + float2(seed, seed));
}