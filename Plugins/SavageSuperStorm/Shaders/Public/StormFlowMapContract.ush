/**
 * @file StormFlowMapContract.ush
 * @brief Defines flow-map decoding and phase evaluation.
 */

#pragma once

float3 StormDecodeFlowMapVelocity(float4 EncodedFlow)
{
	float3 decodedDirection = EncodedFlow.rgb * 2.0 - 1.0;

	float directionLengthSquared = dot(decodedDirection, decodedDirection);

	return directionLengthSquared > 1.0e-10 ? decodedDirection * rsqrt(directionLengthSquared) * saturate(EncodedFlow.a) : 0.0;
}