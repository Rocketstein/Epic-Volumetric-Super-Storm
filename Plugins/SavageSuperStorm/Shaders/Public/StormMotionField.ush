/**
 * @file StormMotionField.ush
 * @brief Provides ring-based storm motion sampling.
 */

#pragma once

static const uint STORM_MDR_MAX_RING_COUNT          = 6u;
static const uint STORM_MDR_TRANSITION_SPEED_BLEND  = 0u;
static const uint STORM_MDR_TRANSITION_RESULT_BLEND = 1u;
static const uint  STORM_MDR_TRANSITION_JITTERED    = 2u;
static const float STORM_TWO_PI                     = 6.28318530718f;

// StormMDRDebugRingInfluence is kept outside the motion payload. Toggling an
// editor visualization must not change the parameters that select or animate
// a ring; the material uses this separate scalar only when blending debug color.

struct FStormMDRParameters
{
	float4 Boundaries0;
	float4 Boundaries1;
	float4 Speeds0;
	float4 Speeds1;
	float4 Phases0;
	float4 Phases1;
	float4 Skews0;
	float4 Skews1;
	float4 Control0;
	float4 Control1;
};

struct FStormMDRRingPair
{
	uint  RingA;
	uint  RingB;
	float Blend;
};

struct FStormMDRSampleState
{
	uint  RingA;
	uint  RingB;
	float RingBlend;
	float MotionMask;
	float PhaseA;
	float PhaseB;
	float TurnsA;
	float TurnsB;
	float StaticTwist;
};

FStormMDRParameters StormMDRDecodeParameters(float4 Boundaries0, float4 Boundaries1, float4 Speeds0, float4 Speeds1, float4 Phases0, float4 Phases1, float4 Skews0, float4 Skews1, float4 Control0, float4 Control1)
{
	FStormMDRParameters result;
	result.Boundaries0 = Boundaries0;
	result.Boundaries1 = Boundaries1;
	result.Speeds0     = Speeds0;
	result.Speeds1     = Speeds1;
	result.Phases0     = Phases0;
	result.Phases1     = Phases1;
	result.Skews0      = Skews0;
	result.Skews1      = Skews1;
	result.Control0    = Control0;
	result.Control1    = Control1;
	return result;
}

float StormMDRHash21(float2 value)
{
	float2 p = frac(value * float2(123.34, 456.21));
	p        += dot(p, p + 45.32);
	return frac(p.x * p.y);
}

float2 StormMDRRotate2D(float2 value, float angleRadians)
{
	float sineValue;
	float cosineValue;
	sincos(angleRadians, sineValue, cosineValue);
	return float2(cosineValue * value.x - sineValue * value.y, sineValue * value.x + cosineValue * value.y);
}

float StormMDRGetPhase(FStormMDRParameters parameters, uint ringIndex)
{
	if (ringIndex == 0u)
	{
		return parameters.Phases0.x;
	}
	if (ringIndex == 1u)
	{
		return parameters.Phases0.y;
	}
	if (ringIndex == 2u)
	{
		return parameters.Phases0.z;
	}
	if (ringIndex == 3u)
	{
		return parameters.Phases0.w;
	}
	if (ringIndex == 4u)
	{
		return parameters.Phases1.x;
	}
	return parameters.Phases1.y;
}

/** @brief Whole turns elapsed on a ring; the unwrapped phase is GetPhase + GetTurns * 2pi. */
float StormMDRGetTurns(FStormMDRParameters parameters, uint ringIndex)
{
	if (ringIndex == 0u)
	{
		return parameters.Speeds0.x;
	}
	if (ringIndex == 1u)
	{
		return parameters.Speeds0.y;
	}
	if (ringIndex == 2u)
	{
		return parameters.Speeds0.z;
	}
	if (ringIndex == 3u)
	{
		return parameters.Speeds0.w;
	}
	if (ringIndex == 4u)
	{
		return parameters.Speeds1.x;
	}
	return parameters.Speeds1.y;
}

uint StormMDRGetRingCount(FStormMDRParameters parameters)
{
	if (parameters.Control1.z < 1.0)
	{
		return STORM_MDR_MAX_RING_COUNT;
	}

	return clamp((uint)round(parameters.Control1.z), 1u, STORM_MDR_MAX_RING_COUNT);
}

uint StormMDRGetTransitionMode(FStormMDRParameters parameters)
{
	return min((uint)round(max(parameters.Control0.y, 0.0)), 2u);
}

float StormMDRGetLFMultiplier(FStormMDRParameters parameters)
{
	return max(parameters.Control0.z, 0.0);
}

float StormMDRGetHFMultiplier(FStormMDRParameters parameters)
{
	return max(parameters.Control0.w, 0.0);
}

float StormMDRGetCurlMultiplier(FStormMDRParameters parameters)
{
	return max(parameters.Control1.x, 0.0);
}

uint StormMDRFindSingleRing(float radius01, FStormMDRParameters parameters)
{
	const uint ringCount = StormMDRGetRingCount(parameters);
	if (ringCount > 1u && radius01 < parameters.Boundaries0.x)
	{
		return 0u;
	}
	if (ringCount > 2u && radius01 < parameters.Boundaries0.y)
	{
		return 1u;
	}
	if (ringCount > 3u && radius01 < parameters.Boundaries0.z)
	{
		return 2u;
	}
	if (ringCount > 4u && radius01 < parameters.Boundaries0.w)
	{
		return 3u;
	}
	if (ringCount > 5u && radius01 < parameters.Boundaries1.x)
	{
		return 4u;
	}
	return ringCount - 1u;
}

FStormMDRRingPair StormMDRMakeSingleRingPair(uint ringIndex)
{
	FStormMDRRingPair result;
	result.RingA = ringIndex;
	result.RingB = ringIndex;
	result.Blend = 0.0;
	return result;
}

FStormMDRRingPair StormMDRMakeBoundaryPair(uint ringA, uint ringB, float radius01, float boundary01, float halfOverlap01)
{
	FStormMDRRingPair result;
	result.RingA = ringA;
	result.RingB = ringB;
	result.Blend = smoothstep(boundary01 - halfOverlap01, boundary01 + halfOverlap01, radius01);
	return result;
}

FStormMDRRingPair StormMDRFindOverlappingRingPair(float radius01, FStormMDRParameters parameters)
{
	const uint  ringCount      = StormMDRGetRingCount(parameters);
	const float overlapWidth01 = max(parameters.Boundaries1.y, 0.0);
	const float halfOverlap01  = 0.5 * overlapWidth01;

	if (halfOverlap01 > 0.0)
	{
		const float boundary0 = parameters.Boundaries0.x;
		if (ringCount > 1u && abs(radius01 - boundary0) <= halfOverlap01)
		{
			return StormMDRMakeBoundaryPair(0u, 1u, radius01, boundary0, halfOverlap01);
		}

		const float boundary1 = parameters.Boundaries0.y;
		if (ringCount > 2u && abs(radius01 - boundary1) <= halfOverlap01)
		{
			return StormMDRMakeBoundaryPair(1u, 2u, radius01, boundary1, halfOverlap01);
		}

		const float boundary2 = parameters.Boundaries0.z;
		if (ringCount > 3u && abs(radius01 - boundary2) <= halfOverlap01)
		{
			return StormMDRMakeBoundaryPair(2u, 3u, radius01, boundary2, halfOverlap01);
		}

		const float boundary3 = parameters.Boundaries0.w;
		if (ringCount > 4u && abs(radius01 - boundary3) <= halfOverlap01)
		{
			return StormMDRMakeBoundaryPair(3u, 4u, radius01, boundary3, halfOverlap01);
		}

		const float boundary4 = parameters.Boundaries1.x;
		if (ringCount > 5u && abs(radius01 - boundary4) <= halfOverlap01)
		{
			return StormMDRMakeBoundaryPair(4u, 5u, radius01, boundary4, halfOverlap01);
		}
	}

	return StormMDRMakeSingleRingPair(StormMDRFindSingleRing(radius01, parameters));
}

float StormMDRStableJitteredRadius(float radius01, float2 bodyCoord, FStormMDRParameters parameters)
{
	const float overlapWidth01 = max(parameters.Boundaries1.y, 0.0);
	if (overlapWidth01 <= 0.0)
	{
		return radius01;
	}

	const float  stableStormId = parameters.Control1.y;
	const float  cellFrequency = max(32.0, 2.0 / max(overlapWidth01, 1.0e-3));
	const float2 cell          = floor(bodyCoord * cellFrequency);
	const float  jitter        = StormMDRHash21(cell + float2(stableStormId * 0.0137, stableStormId * 0.0191));
	return radius01 + (jitter - 0.5) * overlapWidth01;
}

FStormMDRRingPair StormMDRResolveRingPair(float radius01, float2 bodyCoord, FStormMDRParameters parameters)
{
	if (StormMDRGetTransitionMode(parameters) == STORM_MDR_TRANSITION_JITTERED)
	{
		const float jitteredRadius = StormMDRStableJitteredRadius(radius01, bodyCoord, parameters);
		return StormMDRMakeSingleRingPair(StormMDRFindSingleRing(jitteredRadius, parameters));
	}

	return StormMDRFindOverlappingRingPair(radius01, parameters);
}

float3 StormMDRGetDebugRingColor(uint ringIndex)
{
	// Keep these colors in sync with the editor visualizer's 47/255 HSV stride.
	// Explicit constants make the material result deterministic on every shader
	// platform and preserve the colors used by Perforce changelist 159.
	if (ringIndex == 0u)
	{
		return float3(1.000, 0.255, 0.255);
	}
	if (ringIndex == 1u)
	{
		return float3(0.921, 1.000, 0.255);
	}
	if (ringIndex == 2u)
	{
		return float3(0.255, 1.000, 0.413);
	}
	if (ringIndex == 3u)
	{
		return float3(0.255, 0.763, 1.000);
	}
	if (ringIndex == 4u)
	{
		return float3(0.570, 0.255, 1.000);
	}
	return float3(1.000, 0.255, 0.605);
}

float3 StormMDRBlendDebugRingColor(FStormMDRRingPair pair)
{
	const float blend       = saturate(pair.Blend);
	const float visibilityA = (pair.RingA < STORM_MDR_MAX_RING_COUNT - 1u) ? 1.0 : 0.0;
	const float visibilityB = (pair.RingB < STORM_MDR_MAX_RING_COUNT - 1u) ? 1.0 : 0.0;
	const float weightA     = (1.0 - blend) * visibilityA;
	const float weightB     = blend * visibilityB;
	const float weightSum   = weightA + weightB;

	// The sixth palette entry is pink. It is intentionally excluded from the
	// debug overlay because coloring that full outer volume reads as a wall in
	// oblique views. During the Ring 5/6 overlap, keep Ring 5's color while its
	// visibility fades out instead of blending toward pink.
	return (
		StormMDRGetDebugRingColor(pair.RingA) * weightA
		+ StormMDRGetDebugRingColor(pair.RingB) * weightB)
		/ max(weightSum, 1.0e-5);
}

float StormMDRBlendDebugRingVisibility(FStormMDRRingPair pair)
{
	const float visibilityA = (pair.RingA < STORM_MDR_MAX_RING_COUNT - 1u) ? 1.0 : 0.0;
	const float visibilityB = (pair.RingB < STORM_MDR_MAX_RING_COUNT - 1u) ? 1.0 : 0.0;
	return lerp(visibilityA, visibilityB, saturate(pair.Blend));
}

float StormMDRRadialMask(float radius01, FStormMDRParameters parameters)
{
	const float outerRadius = max(parameters.Boundaries1.z, 1.0e-4);
	const float feather     = clamp(parameters.Boundaries1.w, 0.0, outerRadius);
	if (feather <= 1.0e-5)
	{
		return 1.0 - step(outerRadius, radius01);
	}

	return 1.0 - smoothstep(max(outerRadius - feather, 0.0), outerRadius, radius01);
}

float StormMDRHeightMask(float height01, FStormMDRParameters parameters)
{
	const float minimumHeight = saturate(parameters.Skews1.z);
	const float maximumHeight = clamp(parameters.Skews1.w, minimumHeight + 1.0e-4, 1.0);
	const float feather       = max(parameters.Control0.x, 1.0e-4);

	const float lowerMask = smoothstep(minimumHeight, min(minimumHeight + feather, maximumHeight), height01);
	const float upperMask = 1.0 - smoothstep(max(maximumHeight - feather, minimumHeight), maximumHeight, height01);
	return saturate(lowerMask * upperMask);
}

float StormMDRMotionMask(float radius01, float height01, float lifecycleStrength, FStormMDRParameters parameters)
{
	const float enabled  = saturate(parameters.Speeds1.w);
	const float strength = max(parameters.Speeds1.z, 0.0);
	return saturate(enabled * strength * saturate(lifecycleStrength) * StormMDRRadialMask(radius01, parameters) * StormMDRHeightMask(height01, parameters));
}

float StormMDRContinuousSkew(float radius01, FStormMDRParameters parameters)
{
	const uint  ringCount         = StormMDRGetRingCount(parameters);
	const float outer0            = parameters.Boundaries0.x;
	const float outer1            = parameters.Boundaries0.y;
	const float outer2            = parameters.Boundaries0.z;
	const float outer3            = parameters.Boundaries0.w;
	const float outer4            = parameters.Boundaries1.x;
	const float motionOuterRadius = max(parameters.Boundaries1.z, 1.0e-4);

	if (ringCount <= 1u)
	{
		return parameters.Skews0.x;
	}

	const float c0 = 0.5 * (0.0 + outer0);
	const float c1 = 0.5 * (outer0 + (ringCount > 2u ? outer1 : motionOuterRadius));
	const float c2 = 0.5 * (outer1 + (ringCount > 3u ? outer2 : motionOuterRadius));
	const float c3 = 0.5 * (outer2 + (ringCount > 4u ? outer3 : motionOuterRadius));
	const float c4 = 0.5 * (outer3 + (ringCount > 5u ? outer4 : motionOuterRadius));
	const float c5 = 0.5 * (outer4 + motionOuterRadius);

	const float s0 = parameters.Skews0.x;
	const float s1 = parameters.Skews0.y;
	const float s2 = parameters.Skews0.z;
	const float s3 = parameters.Skews0.w;
	const float s4 = parameters.Skews1.x;
	const float s5 = parameters.Skews1.y;

	float skew = s0;
	skew       = lerp(skew, s1, saturate((radius01 - c0) / max(c1 - c0, 1.0e-5)));
	if (ringCount <= 2u)
	{
		return skew;
	}
	skew = lerp(skew, s2, saturate((radius01 - c1) / max(c2 - c1, 1.0e-5)));
	if (ringCount <= 3u)
	{
		return skew;
	}
	skew = lerp(skew, s3, saturate((radius01 - c2) / max(c3 - c2, 1.0e-5)));
	if (ringCount <= 4u)
	{
		return skew;
	}
	skew = lerp(skew, s4, saturate((radius01 - c3) / max(c4 - c3, 1.0e-5)));
	if (ringCount <= 5u)
	{
		return skew;
	}
	skew = lerp(skew, s5, saturate((radius01 - c4) / max(c5 - c4, 1.0e-5)));
	return skew;
}

FStormMDRSampleState StormMDRBuildSampleState(float2 bodyCoord, float height01, float lifecycleStrength, FStormMDRParameters parameters)
{
	FStormMDRSampleState    result;
	const float             radius01 = length(bodyCoord);
	const FStormMDRRingPair pair     = StormMDRResolveRingPair(radius01, bodyCoord, parameters);

	result.RingA      = pair.RingA;
	result.RingB      = pair.RingB;
	result.RingBlend  = pair.Blend;
	result.MotionMask = StormMDRMotionMask(radius01, height01, lifecycleStrength, parameters);

	const float shearGain            = max(parameters.Phases1.z, 0.0);
	const float motionOuterRadius    = max(parameters.Boundaries1.z, 1.0e-4);
	const float radiusAcrossMotion01 = saturate(radius01 / motionOuterRadius);
	const float radialShear          = shearGain * (1.0 - smoothstep(0.0, 1.0, radiusAcrossMotion01));

	const float rotationSign   = (parameters.Phases1.w < 0.0) ? -1.0 : 1.0;
	const float continuousSkew = StormMDRContinuousSkew(radius01, parameters);
	const float staticTwist    = rotationSign * (continuousSkew + radialShear);

	result.PhaseA      = StormMDRGetPhase(parameters, pair.RingA);
	result.PhaseB      = StormMDRGetPhase(parameters, pair.RingB);
	result.TurnsA      = StormMDRGetTurns(parameters, pair.RingA);
	result.TurnsB      = StormMDRGetTurns(parameters, pair.RingB);
	result.StaticTwist = staticTwist;
	return result;
}

float StormMDRShortestAngleDelta(float fromAngle, float toAngle)
{
	const float difference = toAngle - fromAngle;
	return atan2(sin(difference), cos(difference));
}

/**
 * @brief Applies a speed multiplier to an unwrapped phase, then wraps the result.
 * @details Scaling the already-wrapped angle makes the [-pi, pi) seam a jump whenever the
 * multiplier is not 1. Reconstructing the turn count first keeps the rotation continuous.
 */
float StormMDRScalePhase(float wrappedPhase, float turnCount, float rotationMultiplier)
{
	const float scaledTurns = frac(turnCount * rotationMultiplier);
	const float scaledPhase = wrappedPhase * rotationMultiplier + scaledTurns * STORM_TWO_PI;
	return atan2(sin(scaledPhase), cos(scaledPhase));
}

float StormMDRSampleAngle(float wrappedPhase, float turnCount, float staticTwist, float rotationMultiplier)
{
	const float multiplier = max(rotationMultiplier, 0.0);
	return -(StormMDRScalePhase(wrappedPhase, turnCount, multiplier) + staticTwist * multiplier);
}

float StormMDRRingASampleAngle(FStormMDRSampleState state, float rotationMultiplier)
{
	return StormMDRSampleAngle(state.PhaseA, state.TurnsA, state.StaticTwist, rotationMultiplier);
}

float StormMDRRingBSampleAngle(FStormMDRSampleState state, float rotationMultiplier)
{
	return StormMDRSampleAngle(state.PhaseB, state.TurnsB, state.StaticTwist, rotationMultiplier);
}

float StormMDRSpeedBlendSampleAngle(FStormMDRSampleState state, float rotationMultiplier)
{
	const float angleA = StormMDRRingASampleAngle(state, rotationMultiplier);
	const float angleB = StormMDRRingBSampleAngle(state, rotationMultiplier);
	return angleA + StormMDRShortestAngleDelta(angleA, angleB) * state.RingBlend;
}
