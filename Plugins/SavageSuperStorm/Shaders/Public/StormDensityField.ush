/**
 * @file StormDensityField.ush
 * @brief Provides core density-profile and erosion functions.
 */

#pragma once

#include "/SavageSuperStormShaders/Public/StormBottomTypeContract.ush"
#include "/SavageSuperStormShaders/Public/StormCoordinates.ush"

struct FStormHeightSample
{
	float MinLayerHeight01;
	float MaxLayerHeight01;
	float HeightInside;
	float HLocal;
};

struct FStormNoiseCoordinates
{
	float3 ReferenceStormLocalKm;
	float3 LFReferencePositionKm;
	float3 HFReferencePositionKm;
	float2 CurlReferencePositionKm;
};

float StormRemap(float Value, float OriginalMin, float OriginalMax, float NewMin, float NewMax)
{
	float denominator = OriginalMax - OriginalMin;
	if (abs(denominator) < 1.0e-4)
	{
		return NewMin;
	}

	return NewMin + ((Value - OriginalMin) / denominator) * (NewMax - NewMin);
}

float StormRemapSaturated(float Value, float OriginalMin, float OriginalMax, float NewMin, float NewMax)
{
	return saturate(StormRemap(Value, OriginalMin, OriginalMax, NewMin, NewMax));
}

float StormDecodeLowFrequencyShape(float4 LFRaw)
{
	float worleyFBM = saturate(saturate(LFRaw.g) * 0.625 + saturate(LFRaw.b) * 0.250 + saturate(LFRaw.a) * 0.125);
	return StormRemapSaturated(saturate(LFRaw.r), (worleyFBM - 1.0), 1.0, 0.0, 1.0);
}

float StormDecodeHighFrequencyFBM(float3 HFRaw)
{
	return saturate(dot(saturate(HFRaw), float3(0.625, 0.250, 0.125)));
}

float StormApplyCoverage(float BaseCloud, float Coverage)
{
	float coverage      = saturate(Coverage);
	float remappedCloud = StormRemapSaturated(saturate(BaseCloud), 1 - coverage, 1.0, 0.0, 1.0);
	return remappedCloud * coverage;
}

float StormEvaluateCoveredBaseCloud(float LFShape, float VerticalProfile, float Coverage)
{
	float baseCloud = saturate(LFShape) * saturate(VerticalProfile);
	return StormApplyCoverage(baseCloud, Coverage);
}

static const float StormUndersideBandTop     = 0.30;
static const float StormUndersideBandFeather = 0.06;

float StormEvaluateWispyToBillowyBlend(float HLocal)
{
	return smoothstep(StormUndersideBandTop - StormUndersideBandFeather, StormUndersideBandTop + StormUndersideBandFeather, saturate(HLocal));
}

float StormEvaluateUndersideCurlWeight(float HLocal, float BottomType)
{
	return (1.0 - StormEvaluateWispyToBillowyBlend(HLocal)) * StormEvaluateBottomTypeWispyAmount(BottomType);
}

float StormEvaluateBottomTypeHFModifier(float3 HFRaw, float HLocal, float BottomType)
{
	float billowPreserve = StormDecodeHighFrequencyFBM(HFRaw);
	float wispyPreserve  = 1.0 - saturate(HFRaw.b);
	float wispyAmount    = StormEvaluateBottomTypeWispyAmount(BottomType);
	float bottomPreserve = lerp(billowPreserve, wispyPreserve, wispyAmount);

	float heightBlend  = StormEvaluateWispyToBillowyBlend(HLocal);
	float preservation = lerp(bottomPreserve, billowPreserve, heightBlend);
	return saturate(1.0 - preservation);
}

float StormEvaluateVerticalProfile(float BottomProfile, float TopProfile)
{
	return saturate(saturate(BottomProfile) * saturate(TopProfile));
}

float StormEvaluateBodyHeightDensityRamp(float HLocal, float Strength, float Power)
{
	float h           = saturate(HLocal);
	float heightT     = pow(h, max(Power, 1.0e-3));
	float bottomScale = 1.0 - saturate(Strength);
	return lerp(bottomScale, 1.0, heightT);
}

float StormEvaluateAnvilEffectiveDepth01(float AnvilStartHeight01, float AnvilDepth01)
{
	return min(saturate(AnvilStartHeight01), saturate(AnvilDepth01));
}

float StormEvaluateAnvilCoord(float HLocal, float AnvilStartHeight01, float AnvilDepth01)
{
	float startHeight = saturate(AnvilStartHeight01);
	float depth       = StormEvaluateAnvilEffectiveDepth01(startHeight, AnvilDepth01);
	return saturate((startHeight - HLocal) / max(depth, 1.0e-3));
}

float StormEvaluateAnvilHeightMask(float HLocal, float AnvilStartHeight01, float AnvilDepth01)
{
	float startHeight = saturate(AnvilStartHeight01);
	float depth       = StormEvaluateAnvilEffectiveDepth01(startHeight, AnvilDepth01);
	float bottom      = startHeight - depth;
	return step(1.0e-4, depth) * step(bottom, HLocal) * step(HLocal, startHeight);
}

float StormEvaluateAnvilWeight(float AnvilStrength)
{
	return saturate(AnvilStrength);
}

float StormApplyHFErosion(float LFShape, float HFModifier, float HFStrength)
{
	float threshold = min(saturate(HFModifier) * saturate(HFStrength), 1.0 - 1.0e-4);
	return StormRemapSaturated(saturate(LFShape), threshold, 1.0, 0.0, 1.0);
}

float StormEvaluateDimensionalProfile(float VerticalProfile, float Coverage, float ShapeMask)
{
	return saturate(VerticalProfile) * saturate(Coverage) * saturate(ShapeMask);
}

float StormEvaluateAnvilCarrierWeight(float BodyDimensionalProfile, float AnvilDimensionalProfile)
{
	float body       = saturate(BodyDimensionalProfile);
	float anvil      = saturate(AnvilDimensionalProfile);
	float anvilShare = anvil / max(body + anvil, 1.0e-4);

	return smoothstep(0.45, 0.55, anvilShare);
}

float StormEvaluateDensityFromDimensionalProfile(float Carrier, float DimensionalProfile, float DensityGamma)
{
	float baseDensity = saturate(saturate(Carrier) - (1.0 - saturate(DimensionalProfile)));
	return pow(baseDensity, max(DensityGamma, 1.0e-3));
}

float StormApplyDensityMasks(float Density, float HeightInside, float StormStencil)
{
	return saturate(Density) * saturate(HeightInside) * saturate(StormStencil);
}

FStormHeightSample StormDecodeLayerHeightSample(float CloudLayerHeight01, float MinLayerHeight01, float MaxLayerHeight01)
{
	FStormHeightSample result;
	result.MinLayerHeight01 = clamp(MinLayerHeight01, 0.0, 1.0 - 1.0e-4);
	result.MaxLayerHeight01 = clamp(MaxLayerHeight01, result.MinLayerHeight01 + 1.0e-4, 1.0);
	result.HeightInside     = step(result.MinLayerHeight01, CloudLayerHeight01) * step(CloudLayerHeight01, result.MaxLayerHeight01);
	result.HLocal           = saturate((CloudLayerHeight01 - result.MinLayerHeight01) / max(result.MaxLayerHeight01 - result.MinLayerHeight01, 1.0e-4));
	return result;
}

FStormHeightSample StormDecodeLayerHeightSample(float CloudLayerHeight01, float4 ShapeRT2)
{
	return StormDecodeLayerHeightSample(CloudLayerHeight01, ShapeRT2.r, ShapeRT2.b);
}

float2 StormClampProfileUV(Texture2D ProfileTex, float ProfileType, float ProfileV)
{
	uint profileWidth;
	uint profileHeight;
	ProfileTex.GetDimensions(profileWidth, profileHeight);
	float2 profileSize = max(float2(profileWidth, profileHeight), float2(1.0, 1.0));
	float2 halfTexel   = 0.5 / profileSize;
	return clamp(float2(saturate(ProfileType), saturate(ProfileV)), halfTexel, 1.0 - halfTexel);
}

float StormEvaluateAnvilProfileDensity(Texture2D AnvilProfileTex, SamplerState AnvilProfileSampler, float AnvilType, float AnvilCoord)
{
	float2 profileUV = StormClampProfileUV(AnvilProfileTex, AnvilType, AnvilCoord);
	return saturate(Texture2DSampleLevel(AnvilProfileTex, AnvilProfileSampler, profileUV, 0).r);
}

float StormSampleCloudTypeProfileAtV(Texture2D TopProfileTex, SamplerState TopProfileSampler, float ProfileV, float CloudType)
{
	float2 profileUV = StormClampProfileUV(TopProfileTex, CloudType, ProfileV);
	return saturate(Texture2DSampleLevel(TopProfileTex, TopProfileSampler, profileUV, 0).r);
}

float StormEvaluateCloudTypeProfile(Texture2D TopProfileTex, SamplerState TopProfileSampler, float HLocal, float CloudType)
{
	return StormSampleCloudTypeProfileAtV(TopProfileTex, TopProfileSampler, 1.0 - saturate(HLocal), CloudType);
}

float StormEvaluateBottomTypeProfile(Texture2D BottomProfileTex, SamplerState BottomProfileSampler, float HLocal, float BottomType)
{
	float2 profileUV = StormClampProfileUV(BottomProfileTex, BottomType, 1.0 - saturate(HLocal));
	return saturate(Texture2DSampleLevel(BottomProfileTex, BottomProfileSampler, profileUV, 0).r);
}