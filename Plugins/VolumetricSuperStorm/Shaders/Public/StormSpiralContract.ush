/**
 * @file StormSpiralContract.ush
 * @brief Defines deterministic spiral coordinate and shaping helpers.
 */

#pragma once

float2 StormSpiralRotate2D(float2 P, float AngleRadians)
{
	float s;
	float c;
	sincos(AngleRadians, s, c);
	return float2(c * P.x - s * P.y, s * P.x + c * P.y);
}