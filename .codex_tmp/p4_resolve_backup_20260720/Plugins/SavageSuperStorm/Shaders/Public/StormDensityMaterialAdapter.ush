// LFMacroMax is an existing serialized input on MF_Erosion. The runtime owns
// it as one hidden lifecycle value so formation exposes no tuning parameters:
// [0,1) forming, 1 mature, [2,3) dissolving, 3 hidden.

struct FStormLifecycleSample
{
    uint Mode; // 0 forming, 1 mature, 2 dissolving, 3 hidden
    float Progress;
};

struct FStormDomainSample
{
    float MatureColumn;
    float MatureStencil;
    float FeederSupport;
    float Radius01;
    float2 BodyCoord;
    float2 Radial;
    float2 Tangent;
};

float StormTransportSmoother01(float Value)
{
    float x = saturate(Value);
    return x * x * x * (x * (x * 6.0 - 15.0) + 10.0);
}

float2 StormTransportSafeDirection(float2 Value)
{
    float lengthSquared = dot(Value, Value);
    return lengthSquared > 1.0e-8
        ? Value * rsqrt(lengthSquared)
        : float2(0.70710678, 0.70710678);
}

float StormTransportHash21(float2 Value)
{
    float2 p = frac(Value * float2(127.1, 311.7));
    p += dot(p, p.yx + 74.7);
    return frac(p.x * p.y);
}

float StormTransportValueNoise2D(float2 Position)
{
    float2 cell = floor(Position);
    float2 local = frac(Position);
    float2 blend = local * local * (3.0 - 2.0 * local);

    float a = StormTransportHash21(cell);
    float b = StormTransportHash21(cell + float2(1.0, 0.0));
    float c = StormTransportHash21(cell + float2(0.0, 1.0));
    float d = StormTransportHash21(cell + float2(1.0, 1.0));
    return lerp(lerp(a, b, blend.x), lerp(c, d, blend.x), blend.y);
}

float StormTransportFBM2D(float2 Position)
{
    float value = 0.0;
    float amplitude = 0.57;
    value += amplitude * StormTransportValueNoise2D(Position);
    Position = mul(float2x2(0.81, -0.59, 0.59, 0.81), Position) * 2.03 + 7.13;
    amplitude *= 0.52;
    value += amplitude * StormTransportValueNoise2D(Position);
    Position = mul(float2x2(0.64, 0.77, -0.77, 0.64), Position) * 2.11 - 4.71;
    amplitude *= 0.50;
    value += amplitude * StormTransportValueNoise2D(Position);
    return saturate(value);
}

float StormTransportMacro(float2 BodyCoord, float HLocal, float Salt)
{
    float2 q = BodyCoord * 2.07
        + float2(HLocal * 0.79, -HLocal * 1.13)
        + float2(Salt * 0.071, -Salt * 0.053);
    float first = StormTransportFBM2D(q);
    float second = StormTransportFBM2D(
        q.yx * float2(-1.83, 1.67) + float2(9.31, -13.47));
    return saturate(first * 0.66 + second * 0.34);
}

float StormTransportLane(float2 BodyCoord, float HLocal)
{
    float macroA = StormTransportMacro(BodyCoord, HLocal, 19.7);
    float macroB = StormTransportMacro(
        BodyCoord * float2(0.73, 1.31) + float2(macroA - 0.5, 0.0),
        HLocal,
        53.9);
    float ridgeA = 1.0 - abs(macroA * 2.0 - 1.0);
    float ridgeB = 1.0 - abs(macroB * 2.0 - 1.0);

    // A weak, noise-warped angular bias lets incomplete inflow bands emerge,
    // but the FBM ridges own most of the field so no equal sectors or clean
    // mathematical spiral can appear.
    float angle = atan2(BodyCoord.y, BodyCoord.x);
    float radius = length(BodyCoord);
    float angularBias = 0.5 + 0.5 * sin(
        angle * lerp(1.37, 2.91, macroB)
        + radius * lerp(2.2, 6.4, macroA)
        + (macroA - macroB) * 4.9);
    float broken = StormTransportMacro(
        BodyCoord * 1.91 + float2(macroB, -macroA),
        HLocal,
        91.1);
    return saturate(
        ridgeA * 0.34
        + ridgeB * 0.26
        + angularBias * broken * 0.18
        + broken * 0.22);
}

FStormLifecycleSample StormDecodeLifecycle(float EncodedControl)
{
    FStormLifecycleSample result;
    if (EncodedControl >= 2.999)
    {
        result.Mode = 3u;
        result.Progress = 1.0;
    }
    else if (EncodedControl >= 1.5)
    {
        result.Mode = 2u;
        result.Progress = saturate(EncodedControl - 2.0);
    }
    else if (EncodedControl < 0.999)
    {
        result.Mode = 0u;
        result.Progress = saturate(EncodedControl);
    }
    else
    {
        result.Mode = 1u;
        result.Progress = 1.0;
    }
    return result;
}

FStormDomainSample StormDecodeTransportDomain(
    float PackedStencil,
    float BottomType,
    float3 LFUVW)
{
    FStormDomainSample result;
    result.MatureColumn = PackedStencil > 1.0 ? 1.0 : 0.0;
    result.MatureStencil = result.MatureColumn > 0.5
        ? saturate(PackedStencil - 1.0)
        : 0.0;
    result.FeederSupport = result.MatureColumn > 0.5
        ? 1.0
        : saturate(PackedStencil);

    // The binder writes a zero StormReferenceCenter, so LFUVW.xy is truly
    // storm-local and gives a continuous direction field around the actor.
    result.Radial = StormTransportSafeDirection(LFUVW.xy);
    result.Tangent = float2(-result.Radial.y, result.Radial.x);

    // BottomType is monotonic over the authored body. FeederSupport extends
    // that coordinate into the invisible surrounding low-cloud domain.
    float centerGain = pow(saturate((BottomType - 0.20) / 0.70), 1.0 / 1.40);
    float matureRadius = saturate(1.0 - centerGain);
    float feederRadius = 1.0 + (1.0 - result.FeederSupport) * 0.68;
    result.Radius01 = lerp(feederRadius, matureRadius, result.MatureColumn);
    result.BodyCoord = result.Radial * result.Radius01;
    return result;
}

float StormNoiseUnitsPerBodyRadius(float3 NoiseUVW, float2 BodyCoord, float MinimumScale)
{
    float bodyRadius = max(length(BodyCoord), 0.16);
    return max(length(NoiseUVW.xy) / bodyRadius, MinimumScale);
}

float StormEvaluateNoiseCompositeUVW(
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float3 LFUVW,
    float3 HFUVW,
    float CurlTiling,
    float CurlDisplacementUVW,
==== YOURS //CptTangerine_Workspace/VolumetricSuperStorm/Plugins/SavageSuperStorm/Shaders/Public/StormDensityMaterialAdapter.ush
// Adapter for the current MF_Erosion Custom node. The public argument list is
// intentionally stable for saved material assets. Legacy underside-wispy and
// Curl inputs are ABI pins only and do not affect density. BottomType and
// TopType are used only for their independent profile LUT lookups.
<<<<
>>>> ORIGINAL //depot/VolumetricSuperStorm/Plugins/SavageSuperStorm/Shaders/Public/StormDensityMaterialAdapter.ush#3
    float HLocal,
    float TopType,
    float HFStrength,
    float HFStrengthAnvil,
    out float OutCoarseNoise)
{
    float2 curlUV = frac(LFUVW.xy * max(abs(CurlTiling), 1.0e-3));
    float2 curlVector = Texture2DSampleLevel(
        CurlNoiseTex, CurlNoiseSampler, curlUV, 0).rg * 2.0 - 1.0;

    // Curl warps only the HF coordinates and fades with physical cloud height.
    float lowerCurlWeight = 1.0 - saturate(HLocal);
    float3 warpedHFUVW = HFUVW;
    warpedHFUVW.xy += curlVector
        * CurlDisplacementUVW
        * lowerCurlWeight;

    float4 lfRaw = Texture3DSampleLevel(
        LFNoiseTex, LFNoiseSampler, frac(LFUVW), 0);
    // LFMacroMax remains in the public material ABI until its Custom-node pin
    // can be removed. It must not alter the pre-shaped Perlin-Worley R.
    float lfShape = StormDecodeLFPerlinWorley(lfRaw);
    // The baked LF carrier is the complete low-frequency morphology. Auxiliary
    // Worley channels and BottomType do not erode or pattern it.
    float lfColumn = lfShape;
    // Preserve the large-scale LF column before HF erosion. The underside
    // ambient model uses this carrier to reject detached fine wisps without
    // changing the final, fully eroded density returned by this function.
    OutCoarseNoise = saturate(lfColumn);

    float3 hfRaw = Texture3DSampleLevel(
        HFNoiseTex, HFNoiseSampler, frac(warpedHFUVW), 0).rgb;
    float hfFbmRaw = saturate(dot(
        hfRaw, float3(0.625, 0.250, 0.125)));
    FStormHFMorphologyResult hfMorphology = StormEvaluateHFMorphology(
        hfFbmRaw,
        TopType);
    float effectiveHFStrength = StormEvaluateHeightAwareHFStrength(
        HLocal, HFStrength, HFStrengthAnvil);
    float erosionThreshold = StormEvaluateHFErosionThreshold(
        hfMorphology.HFDensityField, effectiveHFStrength);
    return StormEvaluateBaseCloudDensity(lfColumn, erosionThreshold);
}

