        // Growth reveals whole LF-scale clumps at full density: a falling
        // threshold on the coarse carrier admits large connected blobs first,
        // so no storm-silhouette speckle ghost ever pre-renders the endpoint.
        float destinationClumpEdge = lerp(1.05, -0.12, condensation);
