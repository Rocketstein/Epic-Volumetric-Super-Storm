float StormEvaluateMaterialDensity(
    Texture2D BottomProfileTex,
    SamplerState BottomProfileSampler,
    Texture2D TopProfileTex,
    SamplerState TopProfileSampler,
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float Coverage,
    float HLocal,
    float HeightInside,
    float BottomType,
    float TopType,
    float StormStencil,
    float AnvilStrength,
    float AnvilDepth,
    float3 LFUVW,
    float3 HFUVW,
    float2 CurlUVW,
    float CurlTiling,
    float CurlDisplacementUVW,
    float LFMacroMax,
    float BottomWispyStrength,
    float BottomHFStrength,
    float BottomCurlStrength,
    float HFStrength,
    float HFStrengthAnvil,
    out float OutCoarseDensity)
{
    FStormLifecycleSample lifecycle = StormDecodeLifecycle(LFMacroMax);
    if (lifecycle.Mode == 3u)
    {
        OutCoarseDensity = 0.0;
        return 0.0;
    }

    float h = saturate(HLocal);
    FStormDomainSample domain = StormDecodeTransportDomain(
        StormStencil, BottomType, LFUVW);

    // 1. LF shape. LF packed Worley channels use positive FBM weights.
    float4 lfRaw = Texture3DSampleLevel(
        LFNoiseTex,
        LFNoiseSampler,
        frac(LFUVW),
        0);
    float lfShape = StormDecodeNubisLFShape(lfRaw);

    // 2. Split vertical profile: independently look up the Bottom and Top
    // types, then multiply the two lookup results exactly once.
    float bottomProfile = StormEvaluateBottomTypeProfile(
        BottomProfileTex,
        BottomProfileSampler,
        h,
        BottomType);
    float topProfile = StormEvaluateCloudTypeProfile(
        TopProfileTex,
        TopProfileSampler,
        h,
        TopType);
    float verticalProfile = StormEvaluateBottomTopVerticalProfile(
        bottomProfile,
        topProfile);

    // 3. 2015 Coverage: remap against 1-Coverage, then multiply by Coverage.
    // Coarse density ends here, before Curl and HF are sampled.
    float coveredBaseCloud = StormEvaluateCoveredBaseCloud(
        lfShape,
        verticalProfile,
        Coverage);
    OutCoarseDensity = StormApplyDensityMasks(
        coveredBaseCloud,
        HeightInside,
        StormStencil);

