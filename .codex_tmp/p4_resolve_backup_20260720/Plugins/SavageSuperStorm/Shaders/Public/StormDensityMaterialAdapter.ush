// Adapter for the current M_SSS graph. LFPos/HFPos are already proportional,
// storm-relative UVW coordinates produced by the material graph. Keeping this
// adapter in USH makes the graph a wiring layer while the density contract and
// noise morphology remain shared shader code.
float StormEvaluateNoiseCompositeUVW(
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float3 LFUVW,
    float3 HFUVW,
    float CurlTiling,
    float CurlDisplacementUVW,
