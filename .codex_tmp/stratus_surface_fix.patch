 // from becoming large interior cavities through artist strength controls.
 inline constexpr float HFErosionBudget = 0.20f;
+inline constexpr float StratusProfileResidual = 0.025f;
+inline constexpr float StratusProfileSolid = 0.125f;
+inline constexpr float StratusBaseErosionBudget = 0.20f;
 
