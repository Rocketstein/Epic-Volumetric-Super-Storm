+float StormEvaluateThinStratusMask(float ProfileMask, float ThresholdShift)
+{
+    float shift = max(ThresholdShift, 0.0);
+    return smoothstep(
+        STORM_STRATUS_PROFILE_RESIDUAL + shift,
+        STORM_STRATUS_PROFILE_SOLID + shift,
+        saturate(ProfileMask));
+}
+
+float StormEvaluateStratusNormalProfile(
+    float BottomProfile,
+    float TopProfile,
+    float TopType,
+    float HFErosionModifier,
+    float EffectiveHFStrength)
+{
+    float rawProfile = saturate(BottomProfile * TopProfile);
+
+    // Type 0 is the thin stratus anchor. By Type 0.5 the authored LUT already
+    // has a full-density overlap, so blend back to the untouched profile.
+    float stratusWeight = 1.0 - smoothstep(
+        0.0, 0.5, saturate(TopType));
+    float bottomThresholdShift = saturate(HFErosionModifier)
+        * saturate(EffectiveHFStrength)
+        * STORM_STRATUS_BASE_EROSION_BUDGET
+        * stratusWeight;
+
+    float thinBottom = StormEvaluateThinStratusMask(
+        BottomProfile, bottomThresholdShift);
+    float thinTop = StormEvaluateThinStratusMask(TopProfile, 0.0);
+    float thinProfile = saturate(thinBottom * thinTop);
+
+    // This is a profile remap, never a density floor: a zero bottom or top LUT
+    // sample remains zero, and an established interior sample remains one.
+    return saturate(lerp(rawProfile, thinProfile, stratusWeight));
+}
