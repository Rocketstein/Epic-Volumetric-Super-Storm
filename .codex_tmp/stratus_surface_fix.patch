+
+inline float EvaluateThinStratusMask(
+    float ProfileMask,
+    float ThresholdShift)
+{
+    const float Shift = FMath::Max(ThresholdShift, 0.0f);
+    return FMath::SmoothStep(
+        StratusProfileResidual + Shift,
+        StratusProfileSolid + Shift,
+        FMath::Clamp(ProfileMask, 0.0f, 1.0f));
+}
+
+inline float EvaluateStratusNormalProfile(
+    float BottomProfile,
+    float TopProfile,
+    float TopType,
+    float HFErosionModifier,
+    float EffectiveHFStrength)
+{
+    const float Bottom = FMath::Clamp(BottomProfile, 0.0f, 1.0f);
+    const float Top = FMath::Clamp(TopProfile, 0.0f, 1.0f);
+    const float RawProfile = Bottom * Top;
+    const float StratusWeight = 1.0f - FMath::SmoothStep(
+        0.0f,
+        0.5f,
+        FMath::Clamp(TopType, 0.0f, 1.0f));
+    const float BottomThresholdShift = FMath::Clamp(
+        HFErosionModifier,
+        0.0f,
+        1.0f)
+        * FMath::Clamp(EffectiveHFStrength, 0.0f, 1.0f)
+        * StratusBaseErosionBudget
+        * StratusWeight;
+    const float ThinProfile = EvaluateThinStratusMask(
+        Bottom,
+        BottomThresholdShift)
+        * EvaluateThinStratusMask(Top, 0.0f);
+    return FMath::Clamp(
+        FMath::Lerp(RawProfile, ThinProfile, StratusWeight),
+        0.0f,
+        1.0f);
+}
 
