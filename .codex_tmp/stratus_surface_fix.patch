 // control from turning geometry-agnostic LF minima into large interior holes.
 static const float STORM_HF_EROSION_BUDGET = 0.20;
 
+// The default Type-0 profile is thinner than the combined bottom/top fade
+// widths, so its two LUT ramps overlap without ever reaching one. Treat the
+// small non-zero lobe as a thin occupied layer, while keeping exact LUT zeroes
+// empty. HF moves only the lower ramp threshold; it cannot excavate a hole
+// once the bottom mask has reached one.
+static const float STORM_STRATUS_PROFILE_RESIDUAL = 0.025;
+static const float STORM_STRATUS_PROFILE_SOLID = 0.125;
+static const float STORM_STRATUS_BASE_EROSION_BUDGET = 0.20;
