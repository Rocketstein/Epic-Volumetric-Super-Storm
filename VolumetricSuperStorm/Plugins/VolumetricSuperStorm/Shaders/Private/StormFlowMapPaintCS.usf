/**
 * @file StormFlowMapPaintCS.usf
 * @brief Paints one flow-map layer into an RGBA16F render target.
 */

#pragma once
#include "/Engine/Public/Platform.ush"

uint   Resolution;
float2 BrushCenterUV;
float  BrushRadiusUV;
float3 BrushDirectionUVW;
float4 BrushEncodedRGBA;
float  BrushStrength;
float  BrushOpacity;
uint   bBrushErase;
uint   bUseEncodedRGBA;

RWTexture2D<float4> FlowMapTexture;

static const float4 NeutralFlowTexel = float4(0.5, 0.5, 0.5, 0.0);

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void ClearFlowMapRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	FlowMapTexture[DispatchThreadID.xy] = NeutralFlowTexel;
}

[numthreads(NUM_THREADS_X, NUM_THREADS_Y, 1)]void StampFlowMapBrushRT(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (DispatchThreadID.x >= Resolution || DispatchThreadID.y >= Resolution)
	{
		return;
	}

	float2 uv                 = (DispatchThreadID.xy + 0.5) / Resolution;
	float  radius             = max(BrushRadiusUV, 1.0e-5);
	float  distanceFromCenter = length(uv - BrushCenterUV);
	if (distanceFromCenter > radius)
	{
		return;
	}

	float falloff     = 1.0 - smoothstep(0.0, radius, distanceFromCenter);
	float blendWeight = saturate(falloff * BrushOpacity);
	if (blendWeight <= 0.0)
	{
		return;
	}

	float4 encodedCurrent = FlowMapTexture[DispatchThreadID.xy];
	if (bUseEncodedRGBA != 0)
	{
		float4 targetEncoded                = bBrushErase != 0 ? NeutralFlowTexel : saturate(BrushEncodedRGBA);
		FlowMapTexture[DispatchThreadID.xy] = lerp(encodedCurrent, targetEncoded, blendWeight);
		return;
	}

	float3 decodedCurrentDirection = encodedCurrent.rgb * 2.0 - 1.0;
	float  currentDirectionLength  = length(decodedCurrentDirection);
	float3 currentFlow             = currentDirectionLength > 1.0e-5 ? decodedCurrentDirection / currentDirectionLength * saturate(encodedCurrent.a) : 0.0;

	float  targetDirectionLength = length(BrushDirectionUVW);
	float3 targetFlow            = (bBrushErase == 0 && targetDirectionLength > 1.0e-5) ? BrushDirectionUVW / targetDirectionLength * saturate(BrushStrength) : 0.0;

	float3 blendedFlow      = lerp(currentFlow, targetFlow, blendWeight);
	float  blendedStrength  = saturate(length(blendedFlow));
	float3 blendedDirection = blendedStrength > 1.0e-5 ? normalize(blendedFlow) : 0.0;

	FlowMapTexture[DispatchThreadID.xy] = blendedStrength > 1.0e-5 ? float4(blendedDirection * 0.5 + 0.5, blendedStrength) : NeutralFlowTexel;
}