/**
 * @file StormDensityDirectMDRAdapter.ush
 * @brief Provides the material density entry point used by the storm material.
 */

#pragma once

#include "/VolumetricSuperStormShaders/Public/StormDensityMaterialAdapter.ush"
#include "/VolumetricSuperStormShaders/Public/StormMotionField.ush"

float StormDirectMDRLifecycleStrength(FStormLifecycleSample Lifecycle)
{
    if (Lifecycle.Mode == 0u)
    {
        return smoothstep(0.15, 0.65, Lifecycle.Progress);
    }
    if (Lifecycle.Mode == 1u)
    {
        return 1.0;
    }
    if (Lifecycle.Mode == 2u)
    {
        return 1.0 - smoothstep(0.65, 1.0, Lifecycle.Progress);
    }
    return 0.0;
}

void StormDirectMDRSampleDensityNoiseMDR(
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float3 LFUVW,
    float3 HFUVW,
    float3 FlowOffsetA,
    float3 FlowOffsetB,
    float FlowWeightA,
    float2 CurlUVW,
    float CurlTiling,
    float CurlDisplacementUVW,
    float HLocal,
    float BaseBottomType,
    float2 MDRBodyCoord,
    FStormLifecycleSample Lifecycle,
    float4 MDRBoundaries0,
    float4 MDRBoundaries1,
    float4 MDRSpeeds0,
    float4 MDRSpeeds1,
    float4 MDRPhases0,
    float4 MDRPhases1,
    float4 MDRSkews0,
    float4 MDRSkews1,
    float4 MDRControl0,
    float4 MDRControl1,
    out float OutLFShape,
    out float OutHFModifier)
{
    FStormMDRParameters mdr = StormMDRDecodeParameters(
        MDRBoundaries0,
        MDRBoundaries1,
        MDRSpeeds0,
        MDRSpeeds1,
        MDRPhases0,
        MDRPhases1,
        MDRSkews0,
        MDRSkews1,
        MDRControl0,
        MDRControl1);

    float lifecycleStrength = StormDirectMDRLifecycleStrength(Lifecycle);
    FStormMDRSampleState state = StormMDRBuildSampleState(
        MDRBodyCoord,
        saturate(HLocal),
        lifecycleStrength,
        mdr);

    if (state.MotionMask <= 1.0e-4)
    {
        StormSampleDensityNoiseUVWPhased(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            LFUVW,
            HFUVW,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            CurlUVW,
            CurlTiling,
            CurlDisplacementUVW,
            HLocal,
            BaseBottomType,
            OutLFShape,
            OutHFModifier);
        return;
    }

    float lfMultiplier = StormMDRGetLFMultiplier(mdr);
    float hfMultiplier = StormMDRGetHFMultiplier(mdr);
    float curlMultiplier = StormMDRGetCurlMultiplier(mdr);

    bool useResultBlend =
        StormMDRGetTransitionMode(mdr) == STORM_MDR_TRANSITION_RESULT_BLEND
        && state.RingA != state.RingB
        && state.RingBlend > 0.0
        && state.RingBlend < 1.0;

    float rotatedLFShape;
    float rotatedHFModifier;

    if (useResultBlend)
    {
        float lfAngleA = StormMDRRingASampleAngle(state, lfMultiplier);
        float lfAngleB = StormMDRRingBSampleAngle(state, lfMultiplier);
        float hfAngleA = StormMDRRingASampleAngle(state, hfMultiplier);
        float hfAngleB = StormMDRRingBSampleAngle(state, hfMultiplier);
        float curlAngleA = StormMDRRingASampleAngle(state, curlMultiplier);
        float curlAngleB = StormMDRRingBSampleAngle(state, curlMultiplier);

        float3 lfA = LFUVW;
        float3 lfB = LFUVW;
        float3 hfA = HFUVW;
        float3 hfB = HFUVW;
        float2 curlA = CurlUVW;
        float2 curlB = CurlUVW;

        lfA.xy = StormMDRRotate2D(lfA.xy, lfAngleA);
        lfB.xy = StormMDRRotate2D(lfB.xy, lfAngleB);
        hfA.xy = StormMDRRotate2D(hfA.xy, hfAngleA);
        hfB.xy = StormMDRRotate2D(hfB.xy, hfAngleB);
        curlA = StormMDRRotate2D(curlA, curlAngleA);
        curlB = StormMDRRotate2D(curlB, curlAngleB);

        float lfShapeA;
        float hfModifierA;
        float lfShapeB;
        float hfModifierB;

        StormSampleDensityNoiseUVWPhased(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            lfA,
            hfA,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            curlA,
            CurlTiling,
            CurlDisplacementUVW,
            HLocal,
            BaseBottomType,
            lfShapeA,
            hfModifierA);

        StormSampleDensityNoiseUVWPhased(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            lfB,
            hfB,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            curlB,
            CurlTiling,
            CurlDisplacementUVW,
            HLocal,
            BaseBottomType,
            lfShapeB,
            hfModifierB);

        rotatedLFShape = lerp(lfShapeA, lfShapeB, state.RingBlend);
        rotatedHFModifier = lerp(
            hfModifierA,
            hfModifierB,
            state.RingBlend);
    }
    else
    {
        float lfAngle = StormMDRSpeedBlendSampleAngle(
            state,
            lfMultiplier);
        float hfAngle = StormMDRSpeedBlendSampleAngle(
            state,
            hfMultiplier);
        float curlAngle = StormMDRSpeedBlendSampleAngle(
            state,
            curlMultiplier);

        float3 rotatedLF = LFUVW;
        float3 rotatedHF = HFUVW;
        float2 rotatedCurl = CurlUVW;

        rotatedLF.xy = StormMDRRotate2D(rotatedLF.xy, lfAngle);
        rotatedHF.xy = StormMDRRotate2D(rotatedHF.xy, hfAngle);
        rotatedCurl = StormMDRRotate2D(rotatedCurl, curlAngle);

        StormSampleDensityNoiseUVWPhased(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            rotatedLF,
            rotatedHF,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            rotatedCurl,
            CurlTiling,
            CurlDisplacementUVW,
            HLocal,
            BaseBottomType,
            rotatedLFShape,
            rotatedHFModifier);
    }

    if (state.MotionMask >= 0.9999)
    {
        OutLFShape = rotatedLFShape;
        OutHFModifier = rotatedHFModifier;
        return;
    }

    float staticLFShape;
    float staticHFModifier;
    StormSampleDensityNoiseUVWPhased(
        LFNoiseTex,
        LFNoiseSampler,
        HFNoiseTex,
        HFNoiseSampler,
        CurlNoiseTex,
        CurlNoiseSampler,
        LFUVW,
        HFUVW,
        FlowOffsetA,
        FlowOffsetB,
        FlowWeightA,
        CurlUVW,
        CurlTiling,
        CurlDisplacementUVW,
        HLocal,
        BaseBottomType,
        staticLFShape,
        staticHFModifier);

    OutLFShape = lerp(
        staticLFShape,
        rotatedLFShape,
        state.MotionMask);
    OutHFModifier = lerp(
        staticHFModifier,
        rotatedHFModifier,
        state.MotionMask);
}

float StormEvaluateDensityMDRCore(
    Texture2D BottomProfileTex,
    SamplerState BottomProfileSampler,
    Texture2D TopProfileTex,
    SamplerState TopProfileSampler,
    Texture2D AnvilProfileTex,
    SamplerState AnvilProfileSampler,
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float Coverage,
    float HLocal,
    float HeightInside,
    float CloudLayerHeight01,
    float BaseBottomType,
    float TopType,
    float StormStencil,
    float3 WorldPosition,
    float3 StormCenterRadius,
    float3 LFUVW,
    float3 HFUVW,
    float3 FlowOffsetA,
    float3 FlowOffsetB,
    float FlowWeightA,
    float2 CurlUVW,
    float LFUnitsPerBodyRadius,
    float HFUnitsPerBodyRadius,
    float CurlUnitsPerBodyRadius,
    float CurlTiling,
    float CurlDisplacementUVW,
    float StormLifecycleControl,
    float RotationSign,
    float OuterBrimRadiusScale,
    float AnvilCoverageField,
    float AnvilHeightTwistRadians,
    float AnvilHeightTwistStart01,
    float AnvilStrength,
    float AnvilAnchorHeight01,
    float DensityGamma,
    float HFStrength,
    float AnvilDepth01,
    float2 MDRBodyCoord,
    float4 MDRBoundaries0,
    float4 MDRBoundaries1,
    float4 MDRSpeeds0,
    float4 MDRSpeeds1,
    float4 MDRPhases0,
    float4 MDRPhases1,
    float4 MDRSkews0,
    float4 MDRSkews1,
    float4 MDRControl0,
    float4 MDRControl1,
    out float OutCoarseDensity)
{
    FStormLifecycleSample lifecycle = StormDecodeLifecycle(
        StormLifecycleControl);
    if (lifecycle.Mode == 3u)
    {
        OutCoarseDensity = 0.0;
        return 0.0;
    }

    float h = saturate(HLocal);
    FStormDomainSample domain = StormDecodeTransportDomain(
        StormStencil,
        WorldPosition,
        StormCenterRadius);

    // Forming density is gated by the transport condensation, and MatureColumn is a factor
    // of both lerp endpoints in StormBuildFormationTransport - an off-column sample is
    // exactly zero, so skip the transport, noise sampling and erosion entirely.
    if (lifecycle.Mode == 0u && domain.MatureColumn <= 0.0)
    {
        OutCoarseDensity = 0.0;
        return 0.0;
    }

    float normalBottom = StormEvaluateBottomTypeProfile(
        BottomProfileTex,
        BottomProfileSampler,
        h,
        BaseBottomType);
    float normalTop = StormEvaluateCloudTypeProfile(
        TopProfileTex,
        TopProfileSampler,
        h,
        TopType);
    float normalProfile = StormEvaluateVerticalProfile(
        normalBottom,
        normalTop);
    float bodyHeightDensityRamp = StormEvaluateBodyHeightDensityRamp(
        h,
        0.35,
        1.0);
    float bodyVerticalProfile = saturate(
        normalProfile * bodyHeightDensityRamp);

    float anvilCoord = StormEvaluateAnvilCoord(
        HLocal,
        AnvilAnchorHeight01,
        AnvilDepth01);
    float anvilHeightMask = StormEvaluateAnvilHeightMask(
        HLocal,
        AnvilAnchorHeight01,
        AnvilDepth01);
    float anvilProfile = StormEvaluateAnvilProfileDensity(
        AnvilProfileTex,
        AnvilProfileSampler,
        TopType,
        anvilCoord);
    float anvilWeight = StormEvaluateAnvilWeight(AnvilStrength);
    float anvilVerticalProfile = saturate(
        anvilProfile * anvilWeight);
    float anvilCoverageField = saturate(AnvilCoverageField);
    bool anvilActive =
        anvilWeight > 1.0e-4
        && anvilHeightMask > 1.0e-4
        && anvilCoverageField > 1.0e-4;

    if (lifecycle.Mode == 1u)
    {
        float bodyLFShape;
        float bodyHFModifier;
        StormDirectMDRSampleDensityNoiseMDR(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            LFUVW,
            HFUVW,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            CurlUVW,
            CurlTiling,
            CurlDisplacementUVW,
            h,
            BaseBottomType,
            MDRBodyCoord,
            lifecycle,
            MDRBoundaries0,
            MDRBoundaries1,
            MDRSpeeds0,
            MDRSpeeds1,
            MDRPhases0,
            MDRPhases1,
            MDRSkews0,
            MDRSkews1,
            MDRControl0,
            MDRControl1,
            bodyLFShape,
            bodyHFModifier);

        float anvilLFShape = bodyLFShape;
        float anvilHFModifier = bodyHFModifier;
        [branch]
        if (anvilActive)
        {
            StormSampleAnvilHeightTwistedNoiseUVWPhased(
                LFNoiseTex,
                LFNoiseSampler,
                HFNoiseTex,
                HFNoiseSampler,
                CurlNoiseTex,
                CurlNoiseSampler,
                domain,
                anvilCoord,
                RotationSign,
                AnvilHeightTwistRadians,
                AnvilHeightTwistStart01,
                LFUnitsPerBodyRadius,
                HFUnitsPerBodyRadius,
                LFUVW,
                HFUVW,
                FlowOffsetA,
                FlowOffsetB,
                FlowWeightA,
                CurlUVW,
                CurlTiling,
                CurlDisplacementUVW,
                h,
                BaseBottomType,
                anvilLFShape,
                anvilHFModifier);
        }

        float fineDensity;
        StormEvaluateBodyAndAnvilDensityFromSharedErosion(
            bodyLFShape,
            bodyHFModifier,
            anvilLFShape,
            anvilHFModifier,
            bodyVerticalProfile,
            Coverage,
            HeightInside,
            anvilVerticalProfile,
            anvilCoverageField,
            anvilHeightMask,
            anvilWeight,
            DensityGamma,
            HFStrength,
            domain.SuperstormCoverage,
            OutCoarseDensity,
            fineDensity);
        return fineDensity;
    }

    if (lifecycle.Mode == 0u)
    {
        float3 transportedLF;
        float3 transportedHF;
        float condensation;
        StormBuildFormationTransport(
            domain,
            h,
            HeightInside,
            lifecycle.Progress,
            RotationSign,
            LFUVW,
            HFUVW,
            LFUnitsPerBodyRadius,
            HFUnitsPerBodyRadius,
            transportedLF,
            transportedHF,
            condensation);

        float bodyLFShape;
        float bodyHFModifier;
        StormDirectMDRSampleDensityNoiseMDR(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            transportedLF,
            transportedHF,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            CurlUVW,
            CurlTiling,
            CurlDisplacementUVW,
            h,
            BaseBottomType,
            MDRBodyCoord,
            lifecycle,
            MDRBoundaries0,
            MDRBoundaries1,
            MDRSpeeds0,
            MDRSpeeds1,
            MDRPhases0,
            MDRPhases1,
            MDRSkews0,
            MDRSkews1,
            MDRControl0,
            MDRControl1,
            bodyLFShape,
            bodyHFModifier);

        float anvilLFShape = bodyLFShape;
        float anvilHFModifier = bodyHFModifier;
        [branch]
        if (anvilActive)
        {
            StormSampleAnvilHeightTwistedNoiseUVWPhased(
                LFNoiseTex,
                LFNoiseSampler,
                HFNoiseTex,
                HFNoiseSampler,
                CurlNoiseTex,
                CurlNoiseSampler,
                domain,
                anvilCoord,
                RotationSign,
                AnvilHeightTwistRadians,
                AnvilHeightTwistStart01,
                LFUnitsPerBodyRadius,
                HFUnitsPerBodyRadius,
                transportedLF,
                transportedHF,
                FlowOffsetA,
                FlowOffsetB,
                FlowWeightA,
                CurlUVW,
                CurlTiling,
                CurlDisplacementUVW,
                h,
                BaseBottomType,
                anvilLFShape,
                anvilHFModifier);
        }

        float destinationCoarse;
        float destinationFine;
        StormEvaluateBodyAndAnvilDensityFromSharedErosion(
            bodyLFShape,
            bodyHFModifier,
            anvilLFShape,
            anvilHFModifier,
            bodyVerticalProfile,
            Coverage,
            HeightInside,
            anvilVerticalProfile,
            anvilCoverageField,
            anvilHeightMask,
            anvilWeight,
            DensityGamma,
            HFStrength,
            domain.SuperstormCoverage,
            destinationCoarse,
            destinationFine);

        float densityBuild = saturate(condensation);
        OutCoarseDensity = destinationCoarse * densityBuild;
        return destinationFine * densityBuild;
    }

    float3 dissolvedLF;
    float3 dissolvedHF;
    float survival;
    StormBuildDissolutionTransport(
        domain,
        h,
        lifecycle.Progress,
        RotationSign,
        LFUVW,
        HFUVW,
        LFUnitsPerBodyRadius,
        HFUnitsPerBodyRadius,
        dissolvedLF,
        dissolvedHF,
        survival);

    float bodyLFShape;
    float bodyHFModifier;
    StormDirectMDRSampleDensityNoiseMDR(
        LFNoiseTex,
        LFNoiseSampler,
        HFNoiseTex,
        HFNoiseSampler,
        CurlNoiseTex,
        CurlNoiseSampler,
        dissolvedLF,
        dissolvedHF,
        FlowOffsetA,
        FlowOffsetB,
        FlowWeightA,
        CurlUVW,
        CurlTiling,
        CurlDisplacementUVW,
        h,
        BaseBottomType,
        MDRBodyCoord,
        lifecycle,
        MDRBoundaries0,
        MDRBoundaries1,
        MDRSpeeds0,
        MDRSpeeds1,
        MDRPhases0,
        MDRPhases1,
        MDRSkews0,
        MDRSkews1,
        MDRControl0,
        MDRControl1,
        bodyLFShape,
        bodyHFModifier);

    float anvilLFShape = bodyLFShape;
    float anvilHFModifier = bodyHFModifier;
    [branch]
    if (anvilActive)
    {
        StormSampleAnvilHeightTwistedNoiseUVWPhased(
            LFNoiseTex,
            LFNoiseSampler,
            HFNoiseTex,
            HFNoiseSampler,
            CurlNoiseTex,
            CurlNoiseSampler,
            domain,
            anvilCoord,
            RotationSign,
            AnvilHeightTwistRadians,
            AnvilHeightTwistStart01,
            LFUnitsPerBodyRadius,
            HFUnitsPerBodyRadius,
            dissolvedLF,
            dissolvedHF,
            FlowOffsetA,
            FlowOffsetB,
            FlowWeightA,
            CurlUVW,
            CurlTiling,
            CurlDisplacementUVW,
            h,
            BaseBottomType,
            anvilLFShape,
            anvilHFModifier);
    }

    float dissolvedCoarse;
    float dissolvedFine;
    StormEvaluateBodyAndAnvilDensityFromSharedErosion(
        bodyLFShape,
        bodyHFModifier,
        anvilLFShape,
        anvilHFModifier,
        bodyVerticalProfile,
        Coverage,
        HeightInside,
        anvilVerticalProfile,
        anvilCoverageField,
        anvilHeightMask,
        anvilWeight,
        DensityGamma,
        HFStrength,
        domain.SuperstormCoverage,
        dissolvedCoarse,
        dissolvedFine);

    float survivalClumpEdge = lerp(1.05, -0.12, survival);
    float survivalClump = smoothstep(
        survivalClumpEdge,
        survivalClumpEdge + 0.12,
        bodyLFShape);
    OutCoarseDensity = dissolvedCoarse * survivalClump;
    return dissolvedFine * survivalClump;
}

float StormEvaluateMaterialDensityMDRDirect(
    Texture2D BottomProfileTex,
    SamplerState BottomProfileSampler,
    Texture2D TopProfileTex,
    SamplerState TopProfileSampler,
    Texture2D AnvilProfileTex,
    SamplerState AnvilProfileSampler,
    Texture3D LFNoiseTex,
    SamplerState LFNoiseSampler,
    Texture3D HFNoiseTex,
    SamplerState HFNoiseSampler,
    Texture2D CurlNoiseTex,
    SamplerState CurlNoiseSampler,
    float Coverage,
    float HLocal,
    float HeightInside,
    float CloudLayerHeight01,
    float BaseBottomType,
    float TopType,
    float StormStencil,
    float3 WorldPosition,
    float3 StormCenterRadius,
    float3 LFUVW,
    float3 HFUVW,
    float3 FlowOffsetA,
    float3 FlowOffsetB,
    float FlowWeightA,
    float2 CurlUVW,
    float LFUnitsPerBodyRadius,
    float HFUnitsPerBodyRadius,
    float CurlUnitsPerBodyRadius,
    float CurlTiling,
    float CurlDisplacementUVW,
    float StormLifecycleControl,
    float RotationSign,
    float OuterBrimRadiusScale,
    float AnvilCoverageField,
    float AnvilTwistRadians,
    float AnvilTwistOrigin,
    float SpiralFullStrengthRadius01,
    float SpiralZeroStrengthRadius01,
    float AnvilStrength,
    float AnvilAnchorHeight01,
    float AnvilDepth01,
    float DensityGamma,
    float HFStrength,
    float2 MDRBodyCoord,
    float4 MDRBoundaries0,
    float4 MDRBoundaries1,
    float4 MDRSpeeds0,
    float4 MDRSpeeds1,
    float4 MDRPhases0,
    float4 MDRPhases1,
    float4 MDRSkews0,
    float4 MDRSkews1,
    float4 MDRControl0,
    float4 MDRControl1,
    out float OutCoarseDensity)
{
    return StormEvaluateDensityMDRCore(
        BottomProfileTex,
        BottomProfileSampler,
        TopProfileTex,
        TopProfileSampler,
        AnvilProfileTex,
        AnvilProfileSampler,
        LFNoiseTex,
        LFNoiseSampler,
        HFNoiseTex,
        HFNoiseSampler,
        CurlNoiseTex,
        CurlNoiseSampler,
        Coverage,
        HLocal,
        HeightInside,
        CloudLayerHeight01,
        BaseBottomType,
        TopType,
        StormStencil,
        WorldPosition,
        StormCenterRadius,
        LFUVW,
        HFUVW,
        FlowOffsetA,
        FlowOffsetB,
        FlowWeightA,
        CurlUVW,
        LFUnitsPerBodyRadius,
        HFUnitsPerBodyRadius,
        CurlUnitsPerBodyRadius,
        CurlTiling,
        CurlDisplacementUVW,
        StormLifecycleControl,
        RotationSign,
        OuterBrimRadiusScale,
        AnvilCoverageField,
        AnvilTwistRadians,
        AnvilTwistOrigin,
        AnvilStrength,
        AnvilAnchorHeight01,
        DensityGamma,
        HFStrength,
        AnvilDepth01,
        MDRBodyCoord,
        MDRBoundaries0,
        MDRBoundaries1,
        MDRSpeeds0,
        MDRSpeeds1,
        MDRPhases0,
        MDRPhases1,
        MDRSkews0,
        MDRSkews1,
        MDRControl0,
        MDRControl1,
        OutCoarseDensity
    );
}
